<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="controllers.EC2Controller"
          styleClass="monitor-root monitor-root-ec2">

        <stylesheets>
                <URL value="@../css/styles.css"/>
        </stylesheets>

        <BorderPane styleClass="monitor-shell">
                <top>
                        <VBox spacing="14" styleClass="monitor-top">
                                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="monitor-hero" style="-fx-background-color: linear-gradient(to right, rgba(15, 23, 42, 0.95), rgba(30, 64, 175, 0.92));">
                                        <VBox spacing="4">
                                                <Label text="EC2 Instances" styleClass="monitor-title"/>
                                                <Label text="Track instance health, utilization, and lifecycle operations in one place." styleClass="monitor-subtitle" wrapText="true"/>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="backButton" text="← Back to Dashboard" onAction="#handleBackToDashboard" styleClass="monitor-btn-muted"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="monitor-controls">
                                        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh" styleClass="monitor-btn-accent"/>
                                        <Button text="Sync from AWS" onAction="#handleSyncFromAWS" styleClass="monitor-btn-warm"/>
                                        <Button fx:id="detectIdleButton" text="Detect Idle" onAction="#handleDetectIdle" styleClass="monitor-btn-info"/>
                                </HBox>
                        </VBox>
                </top>

                <center>
                        <VBox spacing="12" styleClass="monitor-content" BorderPane.alignment="CENTER">
                                <VBox spacing="12" styleClass="monitor-table-panel" VBox.vgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT">
                                                <Label text="Instance Inventory" styleClass="monitor-panel-title"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label text="Live status and utilization" styleClass="monitor-panel-hint"/>
                                        </HBox>

                                        <TableView fx:id="ec2Table" VBox.vgrow="ALWAYS" styleClass="monitor-table">
                                                <columns>
                                                        <TableColumn fx:id="instanceIdColumn" text="Instance ID" prefWidth="210"/>
                                                        <TableColumn fx:id="instanceTypeColumn" text="Type" prefWidth="150"/>
                                                        <TableColumn fx:id="stateColumn" text="State" prefWidth="120"/>
                                                        <TableColumn fx:id="availabilityZoneColumn" text="AZ" prefWidth="150"/>
                                                        <TableColumn fx:id="cpuColumn" text="CPU %" prefWidth="100"/>
                                                        <TableColumn fx:id="idleColumn" text="Idle" prefWidth="90"/>
                                                </columns>
                                        </TableView>
                                </VBox>

                                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="monitor-action-bar">
                                        <Label text="Actions" styleClass="monitor-action-label"/>
                                        <Button fx:id="startButton" text="Start Instance" onAction="#handleStart" styleClass="monitor-btn-success"/>
                                        <Button fx:id="stopButton" text="Stop Instance" onAction="#handleStop" styleClass="monitor-btn-warning"/>
                                        <Button fx:id="terminateButton" text="Terminate Instance" onAction="#handleTerminate" styleClass="monitor-btn-danger"/>
                                </HBox>
                        </VBox>
                </center>
        </BorderPane>
</StackPane>
