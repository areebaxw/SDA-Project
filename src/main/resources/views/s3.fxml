<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.S3Controller" spacing="15">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="S3 Buckets Monitor" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ED7D27;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="backButton" text="Back to Dashboard" onAction="#handleBackToDashboard"
                style="-fx-background-color: #6B7280; -fx-text-fill: white;"/>

        <Button text="Refresh" onAction="#handleRefresh"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>

        <Button text="Sync from AWS" onAction="#handleSyncFromAWS"
                style="-fx-background-color: #FF9900; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <TableView fx:id="s3Table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="bucketNameColumn" text="Bucket Name" prefWidth="220"/>
            <TableColumn fx:id="regionColumn" text="Region" prefWidth="120"/>
            <TableColumn fx:id="objectCountColumn" text="Object Count" prefWidth="120"/>
            <TableColumn fx:id="sizeColumn" text="Total Size (GB)" prefWidth="120"/>
            <TableColumn fx:id="publicColumn" text="Public" prefWidth="90"/>
            <TableColumn fx:id="idleColumn" text="Idle" prefWidth="80"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Actions:" style="-fx-font-weight: bold; -fx-text-fill: #ED7D27;"/>
        <Button text="Delete Bucket" onAction="#handleDeleteBucket"
                style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
    </HBox>

</VBox>
