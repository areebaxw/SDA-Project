<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.CredentialsController"
      styleClass="page-root"
      alignment="CENTER" spacing="20">

    <stylesheets>
        <URL value="@../css/styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- App branding -->
    <Label text="AWS Cloud Governance Tool" styleClass="app-title"/>
    <Label text="Configure Your AWS Credentials" styleClass="app-subtitle"/>

    <Region VBox.vgrow="ALWAYS" minHeight="10"/>

    <!-- Credentials card -->
    <VBox styleClass="auth-panel" alignment="CENTER" maxWidth="460">

        <Label text="AWS Credential Setup" styleClass="form-title"/>

        <Label text="Store your AWS credentials securely in the local database."
               styleClass="hint-label" wrapText="true" maxWidth="380"/>

        <Separator/>

        <Region minHeight="6"/>

        <!-- Access Key -->
        <VBox styleClass="field-vbox">
            <Label text="AWS Access Key ID" styleClass="field-label"/>
            <TextField fx:id="accessKeyField"
                       promptText="e.g. AKIAIOSFODNN7EXAMPLE"
                       styleClass="text-field" maxWidth="Infinity"/>
            <Label text="Usually starts with AKIA – 20 characters" styleClass="hint-label"/>
        </VBox>

        <!-- Secret Key -->
        <VBox styleClass="field-vbox">
            <Label text="AWS Secret Access Key" styleClass="field-label"/>
            <StackPane>
                <PasswordField fx:id="secretKeyField"
                               promptText="40-character secret key"
                               styleClass="password-field" maxWidth="Infinity"/>
                <TextField fx:id="secretKeyVisibleField"
                           promptText="40-character secret key"
                           styleClass="password-field" maxWidth="Infinity"
                           visible="false" managed="false"/>
                <Button text="👁" styleClass="icon-button"
                        onAction="#toggleSecretKey"
                        prefWidth="36" prefHeight="36"
                        StackPane.alignment="CENTER_RIGHT">
                    <StackPane.margin><Insets right="4"/></StackPane.margin>
                </Button>
            </StackPane>
        </VBox>

        <!-- Region -->
        <VBox styleClass="field-vbox">
            <Label text="AWS Region" styleClass="field-label"/>
            <ComboBox fx:id="regionComboBox"
                      promptText="Select a region"
                      styleClass="combo-box" maxWidth="Infinity"/>
        </VBox>

        <!-- Test connection status -->
        <VBox fx:id="statusBox" visible="false" managed="false" spacing="4">
            <HBox fx:id="statusStrip" styleClass="status-strip" spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="statusIcon" text="✓" styleClass="success-label"/>
                <Label fx:id="statusLabel" text="Connection mock OK – real validation in Sprint 2"
                       styleClass="success-label" wrapText="true"/>
            </HBox>
        </VBox>

        <!-- Feedback -->
        <Label fx:id="errorLabel" styleClass="error-label"
               wrapText="true" maxWidth="Infinity"
               visible="false" managed="false"/>

        <Region minHeight="4"/>

        <!-- Action buttons -->
        <HBox spacing="12">
            <Button fx:id="testButton" text="Test Connection (Mock)"
                    styleClass="secondary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    onAction="#handleTestConnection"/>
            <Button fx:id="saveButton" text="Save Credentials"
                    styleClass="primary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    onAction="#handleSave"/>
        </HBox>

        <Separator/>

        <!-- Skip or go to dashboard -->
        <HBox spacing="6" alignment="CENTER">
            <Button text="Skip for now →" styleClass="link-button" onAction="#handleSkip"/>
        </HBox>

    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Label text="Sprint 1 – US-02: AWS Credential Setup (DB only)" styleClass="hint-label"/>

</VBox>
